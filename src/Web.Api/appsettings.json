{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "*"
    ],
    "AllowedHostSuffixes": [
      ".carstore.com"
    ]
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=carstore;Username=postgres;Password=postgres;",
    "Redis": "localhost:6379"
  },
  "AzureBlob": {
    "ConnectionString": "",
    "ContainerName": ""
  },
  "Storage": {
    "Minio": {
      "InternalEndpoint": "",
      "PublicEndpoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "cars",
      "Region": "us-east-1",
      "UseSsl": false,
      "PresignedReadTtlMinutes": 15,
      "PresignedUploadTtlMinutes": 5,
      "MaxUploadSizeMb": 10,
      "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
    }
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "no-reply@carstore.example",
      "FromName": "CarStore",
      "UseStartTls": true
    }
  },
  "AzureDocumentIntelligence": {
    "Endpoint": "",
    "ApiKey": ""
  },
  "LocalStorage": {
    "BasePath": "uploads",
    "BaseUrl": "/uploads"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "clean-architecture",
    "Audience": "developers",
    "ExpirationInMinutes": 60
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "FeatureFlags": {
    "CrmEnumV2": true,
    "CrmSoftDelete": true,
    "CrmBulkExport": true,
    "CrmActivityTl": true,
    "CrmClientNotes": true
  },
  "Tenant": {
    "DevFallbackDealerId": null
  }
}