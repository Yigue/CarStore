{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:5173",
      "http://localhost:4200"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS",
      "PATCH"
    ],
    "AllowedHeaders": [
      "*"
    ]
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=carstore;Username=postgres;Password=postgres;",
    "Redis": "localhost:6379"
  },
  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": ""
  },
  "Storage": {
    "Minio": {
      "InternalEndpoint": "http://minio:9000",
      "PublicEndpoint": "http://localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin123",
      "BucketName": "cars"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "FromAddress": "dev@carstore.local",
      "FromName": "CarStore Dev",
      "UseStartTls": false
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "carstore",
    "Audience": "carstore-api",
    "ExpirationInMinutes": 60
  },
  "FeatureFlags": {
    "SubscriptionEnforcement": true
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "PriceId": "",
    "TrialDays": 14
  }
}